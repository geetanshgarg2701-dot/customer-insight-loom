{
  "name": "evidence-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "postinstall": "node scripts/copy-duckdb-wasm.mjs && node scripts/fetch-model.mjs",
    "build:static": "node scripts/build-static.mjs",
    "check:site": "node scripts/check-site.mjs",
    "test:static": "playwright test -c playwright.static.config.ts",
    "test:pilot": "playwright test -c playwright.pilot.config.ts",
    "typecheck": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@huggingface/transformers": "4.3.2",
    "@supabase/supabase-js": "2.119.2",
    "@xyflow/react": "13.0.2",
    "echarts": "6.1.0",
    "next": "16.4.6",
    "pptxgenjs": "4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
